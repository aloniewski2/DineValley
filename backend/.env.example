# Copy this file to .env and fill in your real keys locally (never commit .env)
# Restaurant data comes from OpenStreetMap and needs no key at all —
# run `npm run data:build` to (re)generate backend/data/places.json.
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.1-8b-instant
FRONTEND_ORIGINS=https://your-frontend-domain.com,https://your-other-domain.com
